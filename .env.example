# Choose one optional LLM provider. The dashboard runs in evidence fallback mode without a key.
FINOPS_LLM_PROVIDER=auto

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local Ollama (no cloud API key)
# FINOPS_LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional when Ollama runs on Windows and FastAPI runs inside WSL:
# OLLAMA_CLI_PATH=/mnt/c/Users/your-user/AppData/Local/Programs/Ollama/ollama.exe
